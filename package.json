{
	"name": "@extrusionsim/client",
	"version": "1.0.30",
	"description": "Official TypeScript/JavaScript client library for EIS Simulation API",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=16.0.0"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"prepublish": "npm run clean && npm run build",
		"test": "node test/test.js",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write src/**/*.ts",
		"update-deps": "npx npm-check-updates -u --target latest && npm install"
	},
	"keywords": [
		"eis",
		"simulation",
		"api",
		"client",
		"typescript",
		"extrusion",
		"aluminum",
		"manufacturing"
	],
	"author": "EIS Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extrusionsim/client.git"
	},
	"bugs": {
		"url": "https://github.com/extrusionsim/client/issues"
	},
	"homepage": "https://docs.extrusionsim.com",
	"devDependencies": {
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	}
}
